---
// One real `pg-probe top` screen, captured by scripts/top-screens.sh and
// converted from ANSI to HTML. The text scales to the width of its box.
// `cols` and `rows` set how many cells show; `x` and `y` skip the first
// columns and rows, to frame one part of the screen.
interface Props {
  name: string;
  cols?: number;
  rows?: number;
  x?: number;
  y?: number;
}
const { name, cols = 160, rows, x = 0, y = 0 } = Astro.props;
const screens = import.meta.glob<string>('../assets/top/*.html', { query: '?raw', import: 'default', eager: true });
const screen = screens[`../assets/top/${name}.html`];
if (!screen) throw new Error(`no top screen named ${name}`);
---
<div class="tui" style={`--cols:${cols};--x:${x};--y:${y};${rows ? `--rows:${rows}` : ''}`} data-rows={rows ? '' : undefined}>
  <pre set:html={screen} />
</div>

<style>
  .tui { container-type: inline-size; background: #211f1c; overflow: hidden; }
  pre {
    margin: 0;
    padding: 0.4em 0;
    color: #eeece9;
    font-family: var(--mono);
    /* JetBrains Mono advances a hair over 0.6 em per cell. */
    font-size: calc(100cqw / (var(--cols) * 0.601));
    line-height: 1.3;
    white-space: pre;
    overflow: hidden;
    /* A terminal draws -> as two cells, not as a ligature. */
    font-variant-ligatures: none;
    /* Fractional advances: rounded to whole pixels, 120 cells outgrow the
       box. */
    text-rendering: geometricPrecision;
    margin: calc(var(--y) * -1.3em) 0 0 calc(var(--x) * -0.6em);
  }
  /* Box drawing, blocks, and dots come from a fallback font; each sits in
     one cell so the columns after it stay aligned. */
  pre :global(i) { font-style: normal; display: inline-block; width: 1ch; overflow: hidden; vertical-align: top; text-align: center; }
  /* Box drawing and blocks are painted to fill their cells, so lines join
     across rows. Each layer is one stroke in the text color. A painted
     element is inline text, one no-break space per cell, so it advances as
     the text does. Vertical padding, which does not move the layout, makes
     its background a little taller than the row, so the strokes of two rows
     meet. */
  pre :global(i.x) {
    --l: 0.08em;
    --hv: 0.16em;
    --c: linear-gradient(currentColor, currentColor);
    display: inline;
    width: auto;
    padding-block: 0.1em;
    /* Positioned, so the next row's span backgrounds paint under it. */
    position: relative;
    background-repeat: no-repeat;
  }
  pre :global(i.v) { background: var(--c) 50% 0 / var(--l) 100% no-repeat; }
  pre :global(i.V) { background: var(--c) 50% 0 / var(--hv) 100% no-repeat; }
  pre :global(i.h) { background: var(--c) 0 50% / 100% var(--l) no-repeat; }
  pre :global(i.H) { background: var(--c) 0 50% / 100% var(--hv) no-repeat; }
  pre :global(i.tl) { background: var(--c) 100% 50% / 50% var(--l) no-repeat, var(--c) 50% 100% / var(--l) 50% no-repeat; }
  pre :global(i.tr) { background: var(--c) 0 50% / 50% var(--l) no-repeat, var(--c) 50% 100% / var(--l) 50% no-repeat; }
  pre :global(i.bl) { background: var(--c) 100% 50% / 50% var(--l) no-repeat, var(--c) 50% 0 / var(--l) 50% no-repeat; }
  pre :global(i.br) { background: var(--c) 0 50% / 50% var(--l) no-repeat, var(--c) 50% 0 / var(--l) 50% no-repeat; }
  pre :global(i.lt) { background: var(--c) 50% 0 / var(--l) 100% no-repeat, var(--c) 100% 50% / 50% var(--l) no-repeat; }
  pre :global(i.lb) { background: var(--c) 50% 0 / var(--l) 50% no-repeat, var(--c) 100% 50% / 50% var(--l) no-repeat; }
  pre :global(i.lo) { background: var(--c) 0 100% / 100% 50% no-repeat; }
  pre :global(i.up) { background: var(--c) 0 0 / 100% 50% no-repeat; }
  pre :global(i.le) { background: var(--c) 0 0 / 50% 100% no-repeat; }
  .tui[data-rows] pre { max-height: calc(var(--rows) * 1.3em + 0.8em); }
</style>
